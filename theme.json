{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Accent",
					"slug": "primary",
					"color": "#0f766e"
				},
				{
					"name": "Accent Hover",
					"slug": "primary-hover",
					"color": "#115e59"
				},
				{
					"name": "Ink",
					"slug": "ink",
					"color": "#111318"
				},
				{
					"name": "Text",
					"slug": "text",
					"color": "#111318"
				},
				{
					"name": "Text Muted",
					"slug": "text-muted",
					"color": "#5b6170"
				},
				{
					"name": "Surface",
					"slug": "secondary",
					"color": "#f6f7f9"
				},
				{
					"name": "Chip",
					"slug": "chip",
					"color": "#f2f7f6"
				},
				{
					"name": "Border",
					"slug": "border",
					"color": "#e6e8ec"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "#ffffff"
				}
			],
			"defaultPalette": false,
			"custom": true,
			"defaultGradients": false
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
				},
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "'Manrope', 'Inter', sans-serif"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Regular",
					"slug": "regular",
					"size": "1rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1.1875rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "clamp(1.75rem, 3vw, 2.25rem)"
				},
				{
					"name": "Huge",
					"slug": "huge",
					"size": "clamp(2.25rem, 5vw, 3.25rem)"
				}
			],
			"customFontSize": true
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--regular)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "800",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var(--wp--preset--color--text)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-hover)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--white)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)"
					}
				},
				"border": {
					"radius": "999px"
				}
			}
		}
	}
}
