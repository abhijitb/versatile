{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#0f766e"
				},
				{
					"name": "Primary Hover",
					"slug": "primary-hover",
					"color": "#115e59"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#14b8a6"
				},
				{
					"name": "Accent Bright",
					"slug": "accent-bright",
					"color": "#2dd4bf"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#f2f7f6"
				},
				{
					"name": "Dark Teal",
					"slug": "dark-teal",
					"color": "#0b3b39"
				},
				{
					"name": "Text",
					"slug": "text",
					"color": "#1f2933"
				},
				{
					"name": "Text Muted",
					"slug": "text-muted",
					"color": "#5f6c7b"
				},
				{
					"name": "Border",
					"slug": "border",
					"color": "#dbe7e4"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "#fdfdfc"
				}
			],
			"defaultPalette": false,
			"custom": true,
			"defaultGradients": false
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Fraunces",
					"slug": "fraunces",
					"fontFamily": "'Fraunces', Georgia, serif"
				},
				{
					"name": "Newsreader",
					"slug": "newsreader",
					"fontFamily": "'Newsreader', Georgia, serif"
				},
				{
					"name": "System Sans",
					"slug": "system-sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.75rem"
				},
				{
					"name": "Regular",
					"slug": "regular",
					"size": "1rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "2.25rem"
				},
				{
					"name": "Huge",
					"slug": "huge",
					"size": "3.125rem"
				}
			],
			"customFontSize": true
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw"],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "var(--wp--preset--font-size--regular)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fraunces)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--text)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-hover)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)"
					}
				},
				"border": {
					"radius": "14px"
				}
			}
		}
	}
}
